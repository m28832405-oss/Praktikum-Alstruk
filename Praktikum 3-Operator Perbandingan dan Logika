        "# 1. Membuat variabel nilai dan kehadiran\n",
        "nilai = 82\n",
        "kehadiran = 90\n",
        "\n",
        "# Syarat kelulusan: nilai minimal 75 dan kehadiran minimal 80%\n",
        "syarat_nilai_minimum = 75\n",
        "syarat_kehadiran_minimum = 80\n",
        "\n",
        "# 2. Menggunakan operator >= untuk memeriksa masing-masing syarat\n",
        "lulus_nilai = nilai >= syarat_nilai_minimum\n",
        "lulus_kehadiran = kehadiran >= syarat_kehadiran_minimum\n",
        "\n",
        "# Menentukan kelulusan keseluruhan menggunakan operator logika 'and'\n",
        "lulus_total = lulus_nilai and lulus_kehadiran\n",
        "\n",
        "# Menampilkan hasil pemeriksaan syarat\n",
        "print(\"--- Hasil Pemeriksaan Kelulusan Praktikum 3 ---\")\n",
        "print(f\"Nilai Mahasiswa ({nilai}) >= 75        : {lulus_nilai}\")\n",
        "print(f\"Kehadiran Mahasiswa ({kehadiran}%) >= 80%: {lulus_kehadiran}\")\n",
        "print(f\"Apakah Mahasiswa Lulus?               : {lulus_total}\")"
      ],
