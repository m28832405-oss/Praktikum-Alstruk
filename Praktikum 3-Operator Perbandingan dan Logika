        "# --- Langkah 1 & 2: Inisialisasi awal & Pemeriksaan Syarat ---\n",
        "nilai = 82\n",
        "kehadiran = 90\n",
        "\n",
        "syarat_nilai = nilai >= 75\n",
        "syarat_kehadiran = kehadiran >= 80\n",
        "\n",
        "print(\"--- Data Awal (Nilai = 82, Kehadiran = 90) ---\")\n",
        "print(\"1. Nilai >= 75      :\", syarat_nilai)\n",
        "print(\"2. Kehadiran >= 80% :\", syarat_kehadiran)\n",
        "\n",
        "# 3. Menggunakan operator 'and' untuk menentukan apakah mahasiswa memenuhi kedua syarat\n",
        "lulus_and = syarat_nilai and syarat_kehadiran\n",
        "print(\"3. Hasil dengan operator 'and':\", lulus_and)\n",
        "\n",
        "\n",
        "# 4. Ubah nilai menjadi 70, jalankan kembali program dan amati perubahan hasil\n",
        "nilai = 70\n",
        "syarat_nilai = nilai >= 75\n",
        "syarat_kehadiran = kehadiran >= 80\n",
        "\n",
        "lulus_and_baru = syarat_nilai and syarat_kehadiran\n",
        "\n",
        "print(\"\\n--- Setelah Nilai Diubah menjadi 70 ---\")\n",
        "print(\"Nilai >= 75      :\", syarat_nilai)\n",
        "print(\"Kehadiran >= 80% :\", syarat_kehadiran)\n",
        "print(\"4. Hasil dengan 'and' setelah nilai = 70:\", lulus_and_baru)\n",
        "# Amati: Hasilnya menjadi False karena salah satu syarat (nilai >= 75) tidak terpenuhi.\n",
