        "# 5. Coba gunakan 'or'. Jelaskan perbedaan hasilnya.\n",
        "lulus_or = syarat_nilai or syarat_kehadiran\n",
        "\n",
        "print(\"\\n--- Percobaan dengan Operator 'or' (Nilai = 70, Kehadiran = 90) ---\")\n",
        "print(\"5. Hasil dengan operator 'or':\", lulus_or)\n",
        "\n",
        "# Penjelasan Perbedaan:\n",
        "# - Operator 'and' akan bernilai True HANYA JIKA KEDUA syarat terpenuhi (True and True).\n",
