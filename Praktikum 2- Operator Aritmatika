        "print(\"Nilai umur:\", umur, \"| Tipe data:\", type(umur))\n",
        "print(\"Nilai berat:\", berat, \"| Tipe data:\", type(berat))\n",
        "print(\"Nilai terdaftar:\", terdaftar, \"| Tipe data:\", type(terdaftar))\n",
        "\n",
        "# 3. Mengubah nilai umur menjadi 20\n",
        "umur = 20\n",
        "print(\"\\n--- Setelah Umur Diubah ---\")\n",
        "print(\"Nilai umur yang baru:\", umur, \"| Tipe data:\", type(umur))\n",
        "# Apa yang berubah? Nilai pada variabel 'umur' berubah dari 19 menjadi 20,\n",
        "# tetapi tipe datanya tetap sama yaitu integer (<class 'int'>).\n",
        "\n",
        "# 4. Penjelasan perbedaan \"19\" dan 19:\n",
        "# - \"19\" (menggunakan tanda kutip) adalah tipe data String (teks/karakter),\n",
        "#   sehingga tidak bisa digunakan untuk operasi matematika secara langsung.\n",
        "# - 19 (tanpa tanda kutip) adalah tipe data Integer (angka bulat),\n",
        "#   sehingga dapat digunakan untuk melakukan perhitungan aritmatika."
      ]
