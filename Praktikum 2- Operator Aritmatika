        "# 1. Membuat variabel harga dan jumlah\n",
        "harga_buku = 12500\n",
        "jumlah_beli = 4\n",
        "\n",
        "# 2. Menghitung total harga\n",
        "total_harga = harga_buku * jumlah_beli\n",
        "\n",
        "# 3. Menghitung sisa pembagian total harga dengan 2.000 menggunakan operator % (modulo)\n",
        "sisa_pembagian = total_harga % 2000\n",
        "\n",
        "# 4. Menghitung harga setelah diskon Rp5.000\n",
        "diskon = 5000\n",
        "harga_setelah_diskon = total_harga - diskon\n",
        "\n",
        " #5. Menampilkan hasil setiap perhitungan dengan label yang jelas\n",
        "print(\"--- Hasil Perhitungan Praktikum 2 ---\")\n",
        "print(f\"Harga Satuan Buku  : Rp{harga_buku:,}\")\n",
        "print(f\"Jumlah Dibeli      : {jumlah_beli} buah\")\n",
        "print(f\"Total Harga        : Rp{total_harga:,}\")\n",
        "print(f\"Sisa Bagi (mod 2000): Rp{sisa_pembagian:,}\")\n",
        "print(f\"Harga Setelah Diskon: Rp{harga_setelah_diskon:,}\")"
